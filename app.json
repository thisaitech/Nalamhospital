{
  "expo": {
    "name": "Nalam Clinic",
    "slug": "nalam-clinic",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nalamclinic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nalam Clinic needs your location to verify you are connected to the office WiFi network for attendance punch-in.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Nalam Clinic needs your location to verify office WiFi for attendance."
      }
    },
    "android": {
      "package": "com.thisaitech.hris",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "NEARBY_WIFI_DEVICES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nalam Clinic to access your location to verify office WiFi for attendance punch-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nalam Clinic to access your photos to set your profile picture."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
